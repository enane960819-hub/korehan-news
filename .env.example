# ───────────────────────────────────────────────────────────────────────
# KoreHani — local development environment variables
# ───────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Production secrets live in:
#  - Supabase Edge Function secrets (`supabase secrets set …`)
#  - `app_settings` table (for anthropic_key, error_notify_webhook)
#  - Cloudflare Pages dashboard (for any build-time vars — currently none)
#
# This file is for OWNER-LOCAL workflows: running `pg_dump` for off-site
# backups, testing Edge Functions locally with `supabase functions serve`,
# manually deploying via `wrangler`. The deployed frontend reads NOTHING
# from env — it ships with the public anon key embedded in
# `korehan-shared.js`.
#
# Closes DR-F12 from audit 16.

# ─── Supabase ─────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Dashboard → Project Settings → Database → Connection string (session pooler)
# Used by pg_dump for off-site backups (see runbook-backup-restore.md)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ─── Anthropic Claude API ─────────────────────────────────────────────
# For local testing of claude-proxy via `supabase functions serve`.
# Production reads this from app_settings.anthropic_key, NOT from env.
ANTHROPIC_KEY=sk-ant-api03-...

# ─── Stripe ───────────────────────────────────────────────────────────
# Local Edge Function testing only — prod has these in `supabase secrets`.
# Speaking Coach v3 currently unused; safe to leave blank in dev.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (email) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# ─── Discord (alerting) ───────────────────────────────────────────────
# Optional — used by notify-critical-error.
# Production reads from app_settings.error_notify_webhook.
DISCORD_NOTIFY_WEBHOOK=https://discord.com/api/webhooks/.../...

# ─── Backup / restore destinations ────────────────────────────────────
# Cloudflare R2 (preferred — see runbook-backup-restore.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=korehani-backups

# ─── Local dev convenience ────────────────────────────────────────────
# Where to drop backups before shipping off-site
LOCAL_BACKUP_DIR=./backups
